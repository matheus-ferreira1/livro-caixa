{
  "name": "livro-caixa",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter '@livro-caixa/api' dev & bun run --filter '@livro-caixa/web' dev",
    "dev:site": "bun run --filter '@livro-caixa/site' dev",
    "test": "bun run --filter '*' test",
    "test:e2e": "playwright test",
    "seed:demo": "bun run --cwd=apps/api seed:demo",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p e2e/tsconfig.json",
    "build": "bun run --filter '@livro-caixa/web' build",
    "build:site": "bun run --filter '@livro-caixa/site' build",
    "capture:site": "bun run --filter '@livro-caixa/site' capture-screenshots"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "22",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "5",
    "prettier": "^3.9.10",
    "typescript": "5",
    "typescript-eslint": "^8.72.1"
  }
}
