ADMIN_EMAIL=admin@livro-caixa.local
ADMIN_NAME=Admin
# Min. 12 characters. Remove this line after the first boot.
ADMIN_PASSWORD=change-me-please
# 127.0.0.1 keeps the port on this machine, behind a reverse proxy. Use 0.0.0.0 to open it to the network.
BIND_ADDRESS=127.0.0.1
# Behind HTTPS: SECURE_COOKIES=true, and TRUST_PROXY=1 when the proxy runs in another container or on the host.
SECURE_COOKIES=false
TRUST_PROXY=loopback
# Optional. brapi.dev token for ETF and FII quotes. Unset, nothing leaves the instance.
BRAPI_TOKEN=
